# Copy to .env for local runs (outside Docker). All settings are optional.
APP_ENV=dev
LOG_LEVEL=INFO
# SITE_TITLE=EMS CyberPatriot Next Generation Scorebot
# DISPLAY_TIMEZONE=America/New_York

# live | capture | replay   (prod only allows live)
SCRAPE_MODE=live
POLL_INTERVAL=60
# SCOREBOARD_URL=https://scoreboard.uscyberpatriot.org/api/team/scores.php

# Capture / replay (dev only)
CAPTURE_DIR=captures
# CAPTURE_SET=2026-11-13_194314   # folder under CAPTURE_DIR, or any path (e.g. tests/fixtures)
REPLAY_SPEED=1
REPLAY_LOOP=false

# Season archive: the full scoreboard, one file per day, in <DATA_DIR>/archive (never in replay)
# ARCHIVE_ENABLED=true

# The settings from here to WATCH_* only seed the database on first start; after that,
# edit them on /admin/board.
# Which teams to store as history (comma-separated, case-insensitive, empty = all).
# Places are still computed on the full board, and the dashboard shows all of it.
COLLECT_LOCATIONS=
COLLECT_DIVISIONS=

# Access control: register with an emailed code, then the admin approves the browser.
# AUTH_ENABLED=false skips it (dev only; prod refuses).
AUTH_ENABLED=true
ADMIN_BOOTSTRAP_TOKEN=dev-admin-token-not-secret
# ADMIN_NOTIFY_EMAIL=you@example.com
# DEVICE_LIFETIME_DAYS=365

# Email: auto = SMTP if SMTP_HOST is set, SES in prod, otherwise logged to the console
MAIL_BACKEND=auto
MAIL_FROM=noreply@example.com
# MAIL_FROM_NAME=          # blank = SITE_TITLE
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Comma-separated team numbers to pin (always collected)
WATCH_TEAMS=
# Where the dashboard opens (all = every one; blank = follow the collection filter),
# the heading for the watched teams, and their School column (e.g. EMS).
DEFAULT_DIVISION=
DEFAULT_STATE=
WATCH_LABEL=Watchlist
WATCH_SCHOOL=
