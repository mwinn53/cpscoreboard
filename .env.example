# Copy to .env for local runs (outside Docker). All settings are optional.
APP_ENV=dev
LOG_LEVEL=INFO

# live | capture | replay   (prod only allows live)
SCRAPE_MODE=live
POLL_INTERVAL=60
# SCOREBOARD_URL=https://scoreboard.uscyberpatriot.org/api/team/scores.php

# Capture / replay (dev only)
CAPTURE_DIR=captures
# CAPTURE_SET=2026-11-13_194314   # folder under CAPTURE_DIR, or any path (e.g. tests/fixtures)
REPLAY_SPEED=1
REPLAY_LOOP=false

# Which teams to keep/store (comma-separated, case-insensitive, empty = all).
# Places are still computed on the full board.
COLLECT_LOCATIONS=
COLLECT_DIVISIONS=

# Access control: register with an emailed code, then the admin approves the browser.
# AUTH_ENABLED=false skips it (dev only; prod refuses).
AUTH_ENABLED=true
ADMIN_BOOTSTRAP_TOKEN=dev-admin-token-not-secret
# ADMIN_NOTIFY_EMAIL=you@example.com
# DEVICE_LIFETIME_DAYS=365

# Email: auto = SMTP if SMTP_HOST is set, SES in prod, otherwise logged to the console
MAIL_BACKEND=auto
MAIL_FROM=noreply@example.com
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Temporary until milestone 3: comma-separated team numbers to pin (always collected)
WATCH_TEAMS=
# Where the dashboard opens (all = every one; blank = follow the collection filter), and
# the heading for the watched teams. First start only, then edited on /admin/board.
DEFAULT_DIVISION=
DEFAULT_STATE=
WATCH_LABEL=Watchlist
